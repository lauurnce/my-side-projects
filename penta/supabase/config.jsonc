{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "penta",
  "db": {
    "major_version": 17
  },
  "storage": {
    "file_size_limit": "50MiB"
  },
  "auth": {
    "site_url": "http://localhost:3000",
    "additional_redirect_urls": [
      "http://localhost:3100"
    ],
    "enable_signup": true,
    "minimum_password_length": 8,
    "email": {
      "enable_signup": true,
      "enable_confirmations": false
    }
  }
}
